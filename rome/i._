  (fork: Y) X Ht2 (X Ht6 Ht7)
  (fork: Y) X Ht3 (X
    (X He0 (X He1 He2))
    (X Hl0 (X Hl1 Hl2))
  )

  (read: H YXHEU SU) X Ht4 (X (X Hi0 Hi1) Hn)

  W Hl1 X Ht5 X Hn X Ht6 X
